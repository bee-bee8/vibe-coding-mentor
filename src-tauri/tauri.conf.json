{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Mentor",
  "version": "0.1.0",
  "identifier": "com.codexmentor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Mentor",
        "width": 1040,
        "height": 760,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
